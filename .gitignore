# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/

# Node — regenerate via `npm install` from package.json/package-lock.json,
# never commit the tree itself (was committed early on; untracked later).
node_modules/

# Data
*.db
*.db-journal
*.sqlite3

# Excel — ignore all by default
*.xlsx

# ...except our synthetic test fixtures
!tests/fixtures/synthetic_*.xlsx

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
.env
.env.*
